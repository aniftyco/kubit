{
  "name": "kubit",
  "version": "0.0.0",
  "description": "A Tailwind CSS UI library for React, sharing one design system with its Blade counterpart",
  "license": "MIT",
  "homepage": "https://github.com/aniftyco/kubit",
  "repository": "aniftyco/kubit",
  "author": {
    "name": "NiftyCo, LLC",
    "url": "https://aniftyco.com"
  },
  "keywords": [
    "react",
    "tailwindcss",
    "ui",
    "components",
    "design-system",
    "base-ui"
  ],
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./kubit.css": "./dist/kubit.css"
  },
  "files": [
    "./dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist/ && tsc -p tsconfig.json --outDir dist && npm run build:theme",
    "build:theme": "node ../scripts/copy-kubit-css.mjs",
    "test": "vitest run",
    "test:types": "tsc -p tsconfig.test.json",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@tabler/icons-react": "^3.46.0",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.6.0"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.0",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "jsdom": "^28.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
