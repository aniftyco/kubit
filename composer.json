{
  "name": "aniftyco/kubit",
  "description": "A Tailwind CSS UI library for Blade and Livewire, sharing one design system with its React counterpart",
  "license": "MIT",
  "authors": [
    {
      "name": "NiftyCo, LLC",
      "homepage": "https://aniftyco.com"
    },
    {
      "name": "Josh Manders",
      "homepage": "https://x.com/joshmanders"
    }
  ],
  "homepage": "https://github.com/aniftyco/kubit",
  "keywords": [
    "Laravel",
    "Blade",
    "Livewire",
    "Tailwind CSS",
    "UI",
    "Components",
    "Design System"
  ],
  "require": {
    "php": "^8.5",
    "blade-ui-kit/blade-icons": "^1.10",
    "gehrisandro/tailwind-merge-php": "^1.2",
    "illuminate/console": "^13.0",
    "illuminate/support": "^13.0",
    "illuminate/view": "^13.0",
    "laravel/prompts": "^0.3.21",
    "livewire/blaze": "^1.0",
    "secondnetwork/blade-tabler-icons": "^3.46",
    "symfony/finder": "^7.4|^8.0"
  },
  "require-dev": {
    "laravel/pint": "^1.27",
    "orchestra/testbench": "^11.1",
    "pestphp/pest": "^5.0"
  },
  "autoload": {
    "psr-4": {
      "NiftyCo\\Kubit\\": "src/"
    },
    "files": [
      "src/helpers.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "post-autoload-dump": [
      "@clear",
      "@prepare"
    ],
    "clear": "@php vendor/bin/testbench package:purge-skeleton --ansi",
    "prepare": "@php vendor/bin/testbench package:discover --ansi",
    "lint": "@php vendor/bin/pint",
    "test": "@php vendor/bin/pest"
  },
  "extra": {
    "laravel": {
      "providers": [
        "NiftyCo\\Kubit\\KubitServiceProvider"
      ]
    }
  },
  "config": {
    "allow-plugins": {
      "pestphp/pest-plugin": true
    },
    "sort-packages": true
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
